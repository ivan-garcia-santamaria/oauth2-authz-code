<!doctype html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

    <link rel="stylesheet" href="/css/styles.css">

    <!-- Prism.js for code formatting-->
    <link rel="stylesheet" href="/css/prism.css">
    <script src="/js/prism.js"></script>

    <title>OAuth 2.0 - Authorization Code Flow</title>
</head>

<body>
    <div class="container" style="margin-top:50px">
        <div class="text-right">
            <a href="<%= logout %>" class="btn btn-danger">Logout</a>
        </div>
        <div class="jumbotron">
            <h2 class="display-4">
                OAuth 2.0 - Authorization Code Flow
            </h2>
            <p class="lead">You need a backend to perform this flow.</p>
        </div>
        <!--Stepper from Codepen: https://codepen.io/thdeux/pen/zBGNrM-->
        <div class="md-stepper-horizontal orange">
            <div class="md-step">
                <a href="/">
                    <div class="md-step-circle"><span>1</span></div>
                </a>
                <div class="md-step-title">Get the authorization code</div>
                <div class="md-step-bar-left"></div>
                <div class="md-step-bar-right"></div>
            </div>
            <div class="md-step active">
                <div class="md-step-circle"><span>2</span></div>
                <div class="md-step-title">Exchange the authorization code for a token</div>
                <div class="md-step-bar-left"></div>
                <div class="md-step-bar-right"></div>
            </div>
            <div class="md-step">
                <div class="md-step-circle"><span>3</span></div>
                <div class="md-step-title">Get the access token</div>
                <div class="md-step-bar-left"></div>
                <div class="md-step-bar-right"></div>
            </div>
            <div class="md-step">
                <div class="md-step-circle"><span>4</span></div>
                <div class="md-step-title">Calling the API</div>
                <div class="md-step-bar-left"></div>
                <div class="md-step-bar-right"></div>
            </div>
        </div>


        <div class="row">
            <div class="col">
                <div class="card">
                    <div class="card-header">
                        Authentication Code Granted
                    </div>
                    <form action="/exchange/the/code/for/a/token" method="POST">
                        <div class="card-body">
                            <p class="card-text">This is your authentication code:</p>
                            <pre class="language-http" id="codeDisplay"><%= code %></pre>
                            <input type="hidden" name="code" id="codeInput" value="<%=code %>" />
                            <p class="card-text">And this is the state that it returned from the authorization server:
                            </p>
                            <pre class="language-http" id="stateDisplay"><%= state %></pre>

                            <!-- Hybrid Flow tokens section -->
                            <div id="hybridTokensSection" style="display: none;">
                                <hr>
                                <h5 class="card-title">Hybrid Flow - Tokens received in fragment</h5>
                                <p class="card-text">Access Token:</p>
                                <pre class="language-http" id="accessTokenDisplay"></pre>

                                <p class="card-text">ID Token:</p>
                                <pre class="language-http" id="idTokenDisplay"></pre>

                                <p class="card-text">Token Type:</p>
                                <pre class="language-http" id="tokenTypeDisplay"></pre>

                                <p class="card-text">Expires In:</p>
                                <pre class="language-http" id="expiresInDisplay"></pre>
                            </div>

                            <p class="card-text">Now you have to exchange it for an access token.</p>
                            <div class="text-center">
                                <input type="submit" class="btn btn-primary"
                                    value="Exchange the code for an access token" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"
        integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1"
        crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"
        integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
        crossorigin="anonymous"></script>

    <!-- Script to extract tokens from URL fragment or query parameters (Hybrid Flow) -->
    <script>
        (function() {
            let params;

            // First, try to get from URL fragment (everything after #)
            const fragment = window.location.hash.substring(1);

            if (fragment) {
                params = new URLSearchParams(fragment);
            } else {
                // If no fragment, try query parameters (everything after ?)
                params = new URLSearchParams(window.location.search);
            }

            const code = params.get('code');
            const state = params.get('state');
            const accessToken = params.get('access_token');
            const idToken = params.get('id_token');
            const tokenType = params.get('token_type');
            const expiresIn = params.get('expires_in');

            // Update code and state if they come from fragment (Hybrid Flow)
            if (code) {
                document.getElementById('codeDisplay').textContent = code;
                document.getElementById('codeInput').value = code;
            }

            if (state) {
                document.getElementById('stateDisplay').textContent = state;
            }

            // If we have tokens, display them
            if (accessToken || idToken) {
                document.getElementById('hybridTokensSection').style.display = 'block';

                if (accessToken) {
                    document.getElementById('accessTokenDisplay').textContent = accessToken;
                }

                if (idToken) {
                    document.getElementById('idTokenDisplay').textContent = idToken;
                }

                if (tokenType) {
                    document.getElementById('tokenTypeDisplay').textContent = tokenType;
                }

                if (expiresIn) {
                    document.getElementById('expiresInDisplay').textContent = expiresIn + ' seconds';
                }
            }
        })();
    </script>
</body>

</html>